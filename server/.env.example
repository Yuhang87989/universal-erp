# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=your_db_password_here

# JWT密钥
